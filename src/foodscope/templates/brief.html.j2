{% macro item_card(item) -%}
{% set food = item.food %}
<article style="margin:18px 0;padding:18px;border:1px solid #d9e2dc;border-radius:12px;background:#ffffff;">
  <h3 style="margin:0 0 8px;font-size:20px;line-height:1.45;">
    <a href="{{ item|source_url }}" style="color:#176b45;text-decoration:none;">{{ item.metadata.get("title_zh") or item.title }}</a>
  </h3>
  <p style="margin:0 0 10px;color:#66736c;font-size:13px;"><strong>原文标题：</strong>{{ item.title }}</p>
  <ul style="margin:0;padding-left:20px;line-height:1.75;">
    <li><strong>发生了什么：</strong>{{ food.what_happened_zh }}</li>
    {% if food.key_facts_zh %}<li><strong>关键事实：</strong><ul>{% for fact in food.key_facts_zh %}<li>{{ fact }}</li>{% endfor %}</ul></li>{% endif %}
    <li><strong>市场 / 分类：</strong>{{ food.markets|join(", ") }} / {{ food.category.value|category_label }}</li>
    {% if item|item_tags %}<li><strong>标签：</strong>{{ item|item_tags|join(", ") }}</li>{% endif %}
    <li><strong>原始来源：</strong><a href="{{ item|source_url }}">{{ item|source_label }}</a></li>
    <li><strong>发布日期：</strong>{{ item.published_at|published_beijing }}</li>
  </ul>
</article>
{%- endmacro %}
<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>食界雷达 · 全球食品产业简报</title></head>
<body style="margin:0;background:#f4f7f5;color:#1f2b25;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;">
  <main style="max-width:760px;margin:0 auto;padding:28px 18px;">
    <header style="padding:24px;border-radius:14px;background:#176b45;color:#ffffff;">
      <h1 style="margin:0 0 12px;font-size:28px;">食界雷达 · 全球食品产业简报</h1>
      <p style="margin:4px 0;">画像：{{ facts.metadata.profile_name }}（{{ facts.metadata.profile_id }}）</p>
      <p style="margin:4px 0;">日期：{{ facts.metadata.date }}</p>
      <p style="margin:4px 0;">覆盖窗口：{{ facts.metadata.window_start.isoformat() }} 至 {{ facts.metadata.window_end.isoformat() }}</p>
      <p style="margin:4px 0;">抓取 {{ facts.metadata.fetched_count }} · 候选 {{ facts.metadata.candidate_count }} · 入选 {{ facts.metadata.selected_count }} · 隔离 {{ facts.metadata.isolated_count }} · 来源成功 {{ facts.metadata.source_success_count }} / 失败 {{ facts.metadata.source_failure_count }}</p>
    </header>
    {% if must_read %}
    <section><h2 style="margin:28px 0 12px;">今日必读</h2>{% for item in must_read %}{{ item_card(item) }}{% endfor %}</section>
    {% endif %}
    {% if news %}
    <section><h2 style="margin:28px 0 12px;">今日新闻</h2>{% for item in news %}{{ item_card(item) }}{% endfor %}</section>
    {% endif %}
    {% if facts.observations %}
    <section style="margin-top:28px;padding:18px;border-radius:12px;background:#e8f1ec;"><h2 style="margin-top:0;">观察与待验证信号</h2><ul>{% for observation in facts.observations %}<li>{{ observation }}</li>{% endfor %}</ul></section>
    {% endif %}
    <footer style="margin-top:28px;padding-top:18px;border-top:1px solid #cbd6cf;color:#5b6861;font-size:12px;line-height:1.7;">
      <p>本简报由 AI 辅助完成多语言翻译、去重、分类、摘要与信号分析，重要结论应回到原始证据复核。</p>
      <p>仅供行业研究参考，不构成法律或合规意见。</p>
      <p>事实快照 SHA-256：<code>{{ facts_hash }}</code></p>
    </footer>
  </main>
</body>
</html>
