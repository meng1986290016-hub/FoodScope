# Environment Variables

# AI API Keys (configure at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
DEEPSEEK_API_KEY=

# WebHook Url (optional for sending notifications)
HORIZON_WEBHOOK_URL=

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=

# Apify Token (required for Twitter scraping)
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=

# FoodScope optional delivery and compliant X API credentials
WECHAT_APP_ID=
WECHAT_APP_SECRET=
X_BEARER_TOKEN=
